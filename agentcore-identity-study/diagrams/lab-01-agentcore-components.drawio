        <mxCell id="rule" value="All configured checks must pass. Any failure = 401. A runtime uses SigV4 OR JWT, never both." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#7a4b00;strokeColor=#7a4b00;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="396" width="480" height="34" as="geometry"/></mxCell>

