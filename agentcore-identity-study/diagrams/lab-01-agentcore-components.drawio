        <mxCell id="title" value="Lab 1: the AgentCore parts to understand" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1a2b4a;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="AWS Securing Agent Identities microcredential. Only AgentCore pieces are shown. IAM, Cognito and CloudWatch basics are left out." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="24" as="geometry"/></mxCell>

